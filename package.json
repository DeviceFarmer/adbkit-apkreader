{
  "name": "@devicefarmer/adbkit-apkreader",
  "version": "3.2.4",
  "description": "Extracts information from APK files.",
  "keywords": [
    "adb",
    "adbkit",
    "android",
    "apk",
    "manifest",
    "AndroidManifest"
  ],
  "bugs": {
    "url": "https://github.com/DeviceFarmer/adbkit-apkreader/issues"
  },
  "license": "Apache-2.0",
  "main": "./index",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeviceFarmer/adbkit-apkreader.git"
  },
  "scripts": {
    "compile": "tsc -p .",
    "format": "prettier --write . && eslint . --fix",
    "lint": "eslint . && prettier --check . && tsc -p test",
    "prepublishOnly": "npm test",
    "pretest": "npm run compile",
    "test": "mocha"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/debug": "^4.1.13",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/yauzl": "^3.4.0",
    "chai": "^6.3.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">= 22"
  },
  "files": [
    "/lib/**/*.js",
    "/lib/**/*.d.ts",
    "/index.js",
    "/index.d.ts",
    "/CHANGELOG.md"
  ],
  "types": "./index.d.ts"
}
